# --- Ollama ---
# The exact model tag you pulled with `ollama pull <tag>`. Verify with `ollama list`.
OLLAMA_MODEL=gemma4:e4b

# --- LangSmith tracing ---
# Flips on LangChain's built-in tracing callback. No code changes needed beyond this.
LANGCHAIN_TRACING_V2=true
# Your LangSmith API key (smith.langchain.com -> Settings -> API Keys)
LANGCHAIN_API_KEY=ls__replace_me
# Groups traces in the LangSmith UI under a named project instead of "default"
LANGCHAIN_PROJECT=conversational-chatbot-ollama-langsmith

# Optional. Only needed for EU-region or self-hosted LangSmith orgs.
# If needed, your LangSmith "API Keys" page will show the exact value to use.
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
