# --- Ollama ---
# The exact model tag you pulled with `ollama pull <tag>`. Verify with `ollama list`.
OLLAMA_MODEL=gemma4:e4b

# --- Langfuse tracing ---
# Create a project and API keys in Langfuse, then replace these placeholders.
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
# Use the URL for your Langfuse region or self-hosted instance.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
